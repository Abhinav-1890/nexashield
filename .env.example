APP_NAME=NexaShield
APP_ENV=development
LOG_LEVEL=INFO
MONGODB_URI=
MONGODB_DATABASE=nexashield
# Wolf Defender semantic injection threshold
NEXASHIELD_WOLF_THRESHOLD=0.15

# Semantic novelty detection
NEXASHIELD_NOVELTY_THRESHOLD=0.65

# LLM gateway
NEXASHIELD_LLM_PROVIDER=mock
NEXASHIELD_LLM_BASE_URL=https://api.openai.com/v1
NEXASHIELD_LLM_MODEL=gpt-4o-mini
NEXASHIELD_LLM_TIMEOUT=30

# Audit logging
NEXASHIELD_AUDIT_REQUIRED=false
